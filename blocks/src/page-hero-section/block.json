{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "anotherstep/page-hero-section",
	"version": "0.1.0",
	"title": "Page Hero Section",
	"category": "widgets",
	"attributes": {
		"heroTitle": {"type": "string", "default": ""},
		"heroDescription": {"type": "string", "default": ""},
		"heroImageId": { "type": "number" },
    	"heroImageUrl": { "type": "string", "default": "" },
		"btn1Text": {"type": "string", "default": ""},
		"btn1Url": {"type": "string", "default": ""},
		"btn2Text": {"type": "string", "default": ""},
		"btn2Url": {"type": "string", "default": ""},
		"layoutType": {"type": "string", "default": "split"},
    	"hasBadge": {"type": "boolean", "default": false},
		"badgeText": {"type": "string", "default": ""},
		"badgeStyle": { "type": "string", "default": "pill-yellow" },
    	"ctaStyle": {"type": "string", "default": "none"},
    	"imageDecoration": {"type": "string", "default": "none"},
		"quoteText": { "type": "string", "default": "" },
		"statsNumber": { "type": "string", "default": "" },
		"statsText": { "type": "string", "default": "" },
		"statsBgColor": { "type": "string", "default": "" },
    	"statsTextColor": { "type": "string", "default": "" },
		"isImageLarge": { "type": "boolean", "default": false },
    	"isStatsRotated": { "type": "boolean", "default": true },
		"hasExtraTextDiv": { "type": "boolean", "default": false },
		"extraDivText": { "type": "string", "default": "" },
        "extraDivIcon": { "type": "string", "default": "" },
        "extraDivIconColor": { "type": "string", "default": "" },
        "extraDivBgColor": { "type": "string", "default": "" }
	},
	"icon": "smiley",
	"description": "Block to be used for any page that has a top hero section to display hero content.",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "page-hero-section",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
