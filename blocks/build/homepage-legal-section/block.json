{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "anotherstep/homepage-legal-section",
  "version": "0.1.0",
  "title": "Homepage Legal Section",
  "category": "widgets",
  "attributes": {
