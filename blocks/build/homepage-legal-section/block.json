      "type": "string",
      "default": "Governing documents, conflict of interest policy, and financial statements are available upon request to:"
    },
    "directorName": {
      "type": "string",
      "default": "Dawn Rich Meitrott"
    },
    "directorTitle": {
      "type": "string",
      "default": "Executive Director"
